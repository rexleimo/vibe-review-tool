{
  "name": "review-editor-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test:review-items": "rm -rf .tmp-tests && tsc -p tsconfig.test.json && node --test tests/reviewItems.test.mjs tests/tauriStorePlugin.test.mjs && rm -rf .tmp-tests",
    "test:release-version": "node --test tests/releaseVersion.test.mjs",
    "test:desktop": "npm run test:review-items && npm run test:release-version",
    "release:assert-version": "node scripts/assert-release-version.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.2.8",
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-store": "^2.4.2",
    "monaco-editor": "^0.55.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
