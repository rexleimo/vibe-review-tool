{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://review-editor.local/schemas/findings.v1.json",
  "title": "Review Engine Findings v1",
  "type": "object",
  "required": ["schema_version", "repo", "mode", "scanned_at", "summary", "findings"],
  "properties": {
    "schema_version": {"const": "findings.v1"},
    "repo": {"type": "string"},
    "mode": {"const": "staged"},
    "scanned_at": {"type": "string"},
    "summary": {
      "type": "object",
      "required": ["total", "by_severity", "blocking_threshold", "blocking_count"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "by_severity": {
          "type": "object",
          "required": ["error", "warning", "info"],
          "properties": {
            "error": {"type": "integer", "minimum": 0},
            "warning": {"type": "integer", "minimum": 0},
            "info": {"type": "integer", "minimum": 0}
          }
        },
        "blocking_threshold": {"type": "string", "enum": ["error", "warning", "info", "none"]},
        "blocking_count": {"type": "integer", "minimum": 0}
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "rule_id", "severity", "file", "line", "title", "message"],
        "properties": {
          "id": {"type": "string"},
          "rule_id": {"type": "string"},
          "severity": {"type": "string", "enum": ["error", "warning", "info"]},
          "file": {"type": "string"},
          "line": {"type": ["integer", "null"], "minimum": 1},
          "title": {"type": "string"},
          "message": {"type": "string"},
          "suggestion": {"type": "string"}
        }
      }
    }
  }
}
